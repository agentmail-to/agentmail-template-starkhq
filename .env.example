# --- AgentMail ---------------------------------------------------------------
# Get a key at https://agentmail.to/dashboard
AGENTMAIL_API_KEY=

# Verified domain assistants will send from (e.g. assistants.yourcompany.com).
# Verify it in the AgentMail dashboard before deploying.
AGENTMAIL_DOMAIN=

# --- Assistant usernames (optional) -----------------------------------------
# Each assistant gets its own inbox at <username>@<AGENTMAIL_DOMAIN>. If a
# username is already taken globally, the template appends a random suffix.
# Override the defaults below to use your preferred handles.
#
# Inbox creation is idempotent — the assistant id ("friday", "pepper", "happy")
# is passed as AgentMail's clientId, so restarting the server returns the
# existing inbox instead of creating a new one.
#
# Pattern: AGENTMAIL_USERNAME_<ASSISTANT_ID>
AGENTMAIL_USERNAME_FRIDAY=
AGENTMAIL_USERNAME_PEPPER=
AGENTMAIL_USERNAME_HAPPY=

# --- Anthropic ---------------------------------------------------------------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Exa (web search tool) ---------------------------------------------------
# Get a key at https://dashboard.exa.ai
EXA_API_KEY=

# --- Principal ---------------------------------------------------------------
# Your email — assistants use this when escalating something to you via the
# `forward_to_principal` tool.
PRINCIPAL_EMAIL=
